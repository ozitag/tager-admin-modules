{
  "name": "tager-admin-modules",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@3.2.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "./scripts/clean.sh",
    "typecheck": "tsc --build",
    "lint": "eslint \"packages/**/*.{ts,vue}\"",
    "dev": "yarn clean && tsc --build --watch",
    "postinstall": "husky install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@changesets/cli": "^2.24.4",
    "@eslint/js": "^9.39.5",
    "@types/lodash-es": "^4.17.6",
    "@types/node": "24.x",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "copyfiles": "^2.4.1",
    "core-js": "^3.25.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-lodash": "^8.1.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-storybook": "^10.6.6",
    "eslint-plugin-vue": "^10.12.0",
    "husky": "^8.0.1",
    "jsdom": "^31.0.0",
    "lint-staged": "^13.0.3",
    "lodash-es": "^4.17.21",
    "pinia": "^4.1.0",
    "prettier": "^3.9.10",
    "sass": "^1.95.0",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.1.0",
    "vue": "^3.5.0",
    "vue-eslint-parser": "^10.2.0",
    "vue-router": "^4.1.5",
    "zx": "^7.0.8"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
