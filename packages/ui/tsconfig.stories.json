{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    // Stories are bundled by Vite and import ESM-only Storybook 10 packages
    // that expose types only through package.json "exports".
    // The repo-wide classic "node" resolution cannot read those.
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    // `import.meta.env` in .storybook/preview.ts
    "types": ["vite/client"],
    "rootDir": "./",
    "outDir": "./dist",
    "declaration": true,
    "declarationDir": "./dist"
  },
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ],
  "include": [
    "src/**/*.stories.ts",
    "src/**/stories/**/*.ts",
    "src/msw/**/*.ts",
    "src/constants/*.json",
    ".storybook/**/*.ts",
    "custom-types"
  ]
}
