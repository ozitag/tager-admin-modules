{
  "name": "@tager/admin-ui",
  "version": "2.0.8",
  "license": "MIT",
  "access": "public",
  "repository": {
    "type": "git",
    "url": "https://github.com/ozitag/tager-admin-modules.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "main": "./src/main.ts",
  "module": "./src/main.ts",
  "types": "./src/main.ts",
  "exports": {
    "./css": "./src/assets/css/index.css",
    ".": "./src/main.ts"
  },
  "publishConfig": {
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/main.d.ts",
    "exports": {
      ".": {
        "types": "./dist/main.d.ts",
        "default": "./dist/index.mjs"
      },
      "./css": "./dist/style.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:js": "vite build",
    "build:package": "yarn build:js && yarn emit-declarations",
    "emit-declarations": "rm -f ./tsconfig.emit.tsbuildinfo && vue-tsc --project tsconfig.emit.json --emitDeclarationOnly --declarationMap false",
    "storybook": "storybook dev -p 3000",
    "tager:update": "yarn upgrade --latest --scope @tager",
    "build-storybook": "storybook build"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-vue": "^9.0.0",
    "@floating-ui/dom": "^0.4.5",
    "@tager/admin-services": "workspace:*",
    "@tager/admin-wysiwyg": "^2.0.0",
    "@types/leaflet": "^1.7.11",
    "@types/sortablejs": "^1.13.0",
    "autosize": "^5.0.1",
    "ckeditor5": "^49.1.0",
    "highlight.js": "^11.11.1",
    "leaflet": "^1.8.0",
    "libphonenumber-js": "^1.10.28",
    "lodash-es": "*",
    "smoothscroll-polyfill": "^0.4.4",
    "sortablejs": "^1.15.0",
    "tinycolor2": "^1.4.2",
    "vanilla-picker": "^2.12.1",
    "vue3-json-viewer": "^2.4.1"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/vue3-vite": "^10.6.6",
    "@tager/rollup-plugin-lodash": "workspace:*",
    "@types/autosize": "^4.0.1",
    "@types/smoothscroll-polyfill": "^0.3.1",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.3",
    "pinia": "^2.0.21",
    "storybook": "^10.6.6",
    "storybook-vue3-router": "^7.0.0",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "vue": "^3.5.0",
    "vue-router": "^4.1.5",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.0.14"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
