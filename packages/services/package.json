{
  "name": "@tager/admin-services",
  "version": "2.0.1",
  "description": "Tager admin services",
  "author": "Ivan Saranchonkau <ivan.saranchenkov@gmail.com>",
  "license": "MIT",
  "access": "public",
  "repository": {
    "type": "git",
    "url": "https://github.com/ozitag/tager-admin-modules.git",
    "directory": "packages/services"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "emit-declarations": "rm -f ./tsconfig.app.tsbuildinfo && tsc --project ./tsconfig.app.json --emitDeclarationOnly --declarationMap false",
    "build:js": "vite build",
    "build:package": "yarn build:js && yarn emit-declarations"
  },
  "dependencies": {
    "i18next": "^21.9.1",
    "nanoid": "^5.1.11",
    "zod": "^3.18.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "^7.3.7"
  },
  "peerDependencies": {
    "pinia": "*",
    "vue": "*",
    "vue-router": "*"
  }
}
