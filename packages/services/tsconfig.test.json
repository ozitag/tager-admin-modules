{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    // Tests are run through Vite and import ESM-only packages (vitest,
    // @vue/test-utils) that expose types only through package.json "exports".
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationDir": "./dist"
  },
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ],
  "include": ["src/**/*.test.ts"]
}
